<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageProjectUrl>https://www.gizmopowered.net/</PackageProjectUrl>
		<Authors>NETProjects</Authors>
		<Product>Gizmo</Product>
		<Description>Gizmo web api client. This library contains web api clients implementations.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/GAMP/Gizmo.Web.Api.Client</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>NETProjects</Copyright>
		<PackageIcon>package_icon.png</PackageIcon>
		<Version>1.0.13</Version>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="2.5.198" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.6" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="Resources\package_icon.png">
	    <Pack>True</Pack>
	    <PackagePath></PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup Condition="Exists('..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj')">
		<ProjectReference Include="..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj" />
	</ItemGroup>

	<ItemGroup Condition="!Exists('..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj')">
		<PackageReference Include="Gizmo.Web.Api.Models" Version="1.0.14" />
	</ItemGroup>

</Project>
